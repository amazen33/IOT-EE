all:
  vars:
    ansible_user: ${ssh_user}
    cluster_name: ${cluster_name}
  children:
    rke2_servers:
      hosts:
%{ for name, n in servers ~}
        ${name}:
          ansible_host: ${n.ipv4}
          hyperv_host: ${n.host}
%{ endfor ~}
    rke2_agents:
      hosts:
%{ if length(agents) == 0 ~}
        {}
%{ endif ~}
%{ for name, n in agents ~}
        ${name}:
          ansible_host: ${n.ipv4}
          hyperv_host: ${n.host}
%{ endfor ~}
