network:
  version: 2
  ethernets:
    eth0:
      match:
        macaddress: "${mac_colon}"
      set-name: eth0
      dhcp4: false
      addresses:
        - ${ipv4}/${prefix_length}
      routes:
        - to: default
          via: ${gateway}
      nameservers:
        addresses: [${join(", ", dns_servers)}]
%{ if length(search) > 0 ~}
        search: [${join(", ", search)}]
%{ endif ~}
