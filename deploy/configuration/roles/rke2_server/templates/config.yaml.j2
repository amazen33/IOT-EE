# Managed by Ansible (deploy/configuration/roles/rke2_server).
token: "{{ rke2_token }}"
{% if rke2_join_existing %}
server: "https://{{ rke2_api_vip }}:9345"
{% endif %}
node-name: "{{ inventory_hostname }}"
node-ip: "{{ rke2_node_ip }}"
tls-san:
  - "{{ rke2_api_vip }}"
{% if rke2_api_fqdn | length > 0 %}
  - "{{ rke2_api_fqdn }}"
{% endif %}
write-kubeconfig-mode: "0600"
